---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Converter from '../components/converter/preact/Converter.jsx';
---

<Layout>
  <slot name="head">
    <title>Video to PNG Converter - Convert Video to PNG Online Free</title>
    <meta name="description" content="Convert video to PNG online free with our specialized video to PNG converter. Extract frames as lossless PNG images, preserving every detail and color. Ideal for editing, design work, and archival purposes. 100% client-side, no uploads, unlimited conversions.">
    <meta property="og:title" content="Video to PNG Converter - Convert Video to PNG Online Free">
    <meta property="og:description" content="Convert video to PNG online free with our specialized video to PNG converter. Extract frames as lossless PNG images, preserving every detail and color. Ideal for editing, design work, and archival purposes. 100% client-side, no uploads, unlimited conversions.">
    <meta property="og:image" content="/logo.svg">
    <meta property="og:url" content="https://freevideotoimage.com/video-to-png">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Video to PNG Converter - Convert Video to PNG Online Free">
    <meta name="twitter:description" content="Convert video to PNG online free with our specialized video to PNG converter. Extract frames as lossless PNG images, preserving every detail and color. Ideal for editing, design work, and archival purposes. 100% client-side, no uploads, unlimited conversions.">
  </slot>
  <Header currentPath="/video-to-png" />
  <main class="flex-1">
    <section class="py-12 md:py-16 lg:py-20">
      <div class="container">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto mb-10 text-center">
            <p class="eyebrow mb-3">Lossless Extraction</p>
            <h1 class="heading-lg mb-4">Video to PNG Converter</h1>
            <p class="body-lg text-body max-w-[600px] mx-auto">
              Extract frames as lossless PNG images, preserving every detail and color. Ideal for editing, design work, and archival purposes where quality is paramount.
            </p>
          </div>

          <Converter client:visible data-testid="video-converter" />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>