---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout>
  <slot name="head">
    <title>Contact Us - FreeVideoToImage.com</title>
    <meta name="description" content="Get in touch with FreeVideoToImage.com. We'd love to hear your feedback, questions, or suggestions about our video to image converter.">
    <meta property="og:title" content="Contact Us - FreeVideoToImage.com">
    <meta property="og:description" content="Get in touch with FreeVideoToImage.com. We'd love to hear your feedback, questions, or suggestions about our video to image converter.">
    <meta property="og:image" content="/logo.svg">
    <meta property="og:url" content="https://freevideotoimage.com/contact-us">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Contact Us - FreeVideoToImage.com">
    <meta name="twitter:description" content="Get in touch with FreeVideoToImage.com. We'd love to hear your feedback, questions, or suggestions about our video to image converter.">
  </slot>
  <Header currentPath="/contact-us" />
  <main class="flex-1">
    <section class="pt-16 md:pt-20 pb-20 bg-[var(--color-canvas-elevated)]">
      <div class="container">
        <div class="text-center mb-14 max-w-[640px] mx-auto">
          <span class="inline-block text-xs font-semibold tracking-wide uppercase text-[var(--color-link)] mb-3">
            Contact
          </span>
          <h1 class="text-2xl font-bold md:text-3xl mb-4">Let's talk</h1>
          <p class="body-lg text-[var(--color-mute)]">
            Whether you have a question, feedback, or just want to say hello — we'd love to hear from you.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 max-w-[880px] mx-auto">
          <!-- Get in touch card -->
          <div class="rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-8 shadow-sm">
            <h2 class="heading-md mb-6">Get in touch</h2>
            <div class="space-y-5">
              <a
                href="mailto:contact@freevideotoimage.com"
                class="group flex items-start gap-4 rounded-xl p-3 -m-3 transition-colors hover:bg-[var(--color-canvas-elevated)]"
              >
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-link-soft)] text-[var(--color-link)]">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </span>
                <div>
                  <h3 class="heading-sm mb-0.5">Email</h3>
                  <p class="body-md text-[var(--color-mute)] group-hover:text-[var(--color-ink)] transition-colors break-all">
                    contact@freevideotoimage.com
                  </p>
                </div>
              </a>
            </div>
          </div>

          <!-- Privacy card -->
          <div class="rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-8 shadow-sm">
            <h2 class="heading-md mb-6">Our commitment to privacy</h2>
            <div class="flex items-start gap-4">
              <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-cyan-soft)] text-[var(--color-cyan)]">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </span>
              <p class="body-md text-[var(--color-mute)]">
                We value your privacy. Our core service is entirely client-side —
                <span class="text-[var(--color-ink)] font-medium">no video data is ever uploaded to our servers.</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>