---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Converter from '../components/converter/preact/Converter.jsx';
---

<Layout>
  <Header currentPath="/video-frame-extractor" />
  <main class="flex-1">
    <section class="py-12 md:py-16 lg:py-20">
      <div class="container">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto mb-10 text-center">
            <p class="eyebrow mb-3">Professional Extraction</p>
            <h1 class="heading-lg mb-4">Video Frame Extractor</h1>
            <p class="body-lg text-body max-w-[600px] mx-auto">
              Professional-grade frame extraction with advanced settings for interval timing, scene detection, and batch processing. Extract frames at precise intervals or detect scene changes automatically.
            </p>
          </div>

          <Converter client:visible data-testid="video-converter" />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>