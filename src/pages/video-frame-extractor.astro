---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Converter from '../components/converter/preact/Converter.jsx';
---

<Layout>
  <slot name="head">
    <title>Video Frame Extractor - Extract Frames from Videos at Intervals Online Free</title>
    <meta name="description" content="Extract frames from videos at precise intervals or detect scene changes automatically with our professional video frame extractor. 100% client-side, no uploads, unlimited conversions. Supports JPG, PNG, WebP, AVIF formats.">
    <meta property="og:title" content="Video Frame Extractor - Extract Frames from Videos at Intervals Online Free">
    <meta property="og:description" content="Extract frames from videos at precise intervals or detect scene changes automatically with our professional video frame extractor. 100% client-side, no uploads, unlimited conversions. Supports JPG, PNG, WebP, AVIF formats.">
    <meta property="og:image" content="/logo.svg">
    <meta property="og:url" content="https://freevideotoimage.com/video-frame-extractor">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Video Frame Extractor - Extract Frames from Videos at Intervals Online Free">
    <meta name="twitter:description" content="Extract frames from videos at precise intervals or detect scene changes automatically with our professional video frame extractor. 100% client-side, no uploads, unlimited conversions. Supports JPG, PNG, WebP, AVIF formats.">
  </slot>
  <Header currentPath="/video-frame-extractor" />
  <main class="flex-1">
    <section class="py-12 md:py-16 lg:py-20">
      <div class="container">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto mb-10 text-center">
            <p class="eyebrow mb-3">Professional Extraction</p>
            <h1 class="heading-lg mb-4">Video Frame Extractor</h1>
            <p class="body-lg text-body max-w-[600px] mx-auto">
              Professional-grade frame extraction with advanced settings for interval timing, scene detection, and batch processing. Extract frames at precise intervals or detect scene changes automatically.
            </p>
          </div>

          <Converter client:visible data-testid="video-converter" />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>