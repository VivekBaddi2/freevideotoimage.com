---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout>
  <slot name="head">
    <title>Frequently Asked Questions - Video to Image Converter | FreeVideoToImage.com</title>
    <meta name="description" content="Find answers to common questions about our video to image converter, video to JPG converter, video to PNG converter, and frame extraction tools. Learn about privacy, file formats, and usage limits.">
    <meta property="og:title" content="Frequently Asked Questions - Video to Image Converter | FreeVideoToImage.com">
    <meta property="og:description" content="Find answers to common questions about our video to image converter, video to JPG converter, video to PNG converter, and frame extraction tools. Learn about privacy, file formats, and usage limits.">
    <meta property="og:image" content="/logo.svg">
    <meta property="og:url" content="https://freevideotoimage.com/faq">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Frequently Asked Questions - Video to Image Converter | FreeVideoToImage.com">
    <meta name="twitter:description" content="Find answers to common questions about our video to image converter, video to JPG converter, video to PNG converter, and frame extraction tools. Learn about privacy, file formats, and usage limits.">
  </slot>
  <Header currentPath="/faq" />
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative">
      <div class="relative z-10 pt-20 pb-16 md:pt-28 md:pb-20">
        <div class="container">
          <div class="text-center">
            <h1 class="text-xl font-semibold mb-3 text-center">Frequently Asked Questions</h1>
            <p class="body-lg max-w-[600px] mx-auto text-center">
              Find answers to common questions about our video frame extractor.
            </p>
          </div>
        </div>
      </div>
      <!-- Mesh Gradient Background -->
      <div class="absolute inset-0 -z-0 pointer-events-none">
        <svg width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="{colors.cyan}" />
              <stop offset="25%" stop-color="{colors.violet}" />
              <stop offset="50%" stop-color="{colors.pink}" />
              <stop offset="75%" stop-color="{colors.magenta}" />
              <stop offset="100%" stop-color="{colors.cyan}" />
            </linearGradient>
          </defs>
          <rect width="100" height="100" fill="url(#gradient)" opacity="0.08" />
        </svg>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="pt-16 md:pt-20 pb-12">
      <div class="container">
        <div class="text-center mb-16">
          <span class="mono-eyebrow mb-3">Get Help</span>
          <h2 class="heading-lg mb-4 text-center">Questions & Answers</h2>
        </div>
        <div class="max-w-[800px] mx-auto space-y-4">
          <!-- FAQ Items -->
          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              Is there a file size limit?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              Warning at 500MB, hard limit at 2GB. Larger videos may take longer to process and require more memory.
            </div>
          </div>

          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              What video formats are supported?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              MP4, WebM, MOV, AVI, MKV, and most formats playable in your browser. We support all common video codecs.
            </div>
          </div>

          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              Does this upload my video to a server?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              No. All processing happens entirely in your browser. Your video never leaves your device, ensuring complete privacy.
            </div>
          </div>

          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              What output formats are available?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              PNG (lossless), JPG (70-95% quality), WebP (70-95% quality), AVIF (50-80% quality, Safari 16.4+). Choose based on your quality and size needs.
            </div>
          </div>

          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              Can I extract frames from a specific time range?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              Yes. You can set custom start and end times for extraction in all modes (manual, interval, and scene detection).
            </div>
          </div>

          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              Is there a limit to how many frames I can extract?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              No hard limit on frame count. Practical limits depend on your device's memory and the video length. We recommend extracting in batches for very large projects.
            </div>
          </div>

          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              Do I need to create an account?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              No account required. The tool is completely free and accessible immediately without registration or email submission.
            </div>
          </div>

          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              Can I use this on mobile devices?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              Yes! The tool works on any modern browser including mobile Safari and Chrome. For best performance on mobile, we recommend shorter videos.
            </div>
          </div>

          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              Are there any watermarks or branding on exported frames?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              Absolutely not. Exported frames are clean and free of any watermarks, logos, or branding. You get pure, unaltered frames from your video.
            </div>
          </div>

          <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
            <button class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                    onclick="toggleFaq(this)">
              How does smart scene detection work?
              <svg class="faq-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-answer mt-2 text-[var(--color-body)]">
              Scene detection analyzes visual differences between consecutive frames. When the change exceeds your sensitivity threshold, it marks a scene boundary.
              You can adjust the threshold to make detection more or less sensitive to changes.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="pt-12 md:pt-16 pb-10 bg-[var(--color-canvas-elevated)]">
      <div class="container">
        <div class="text-center">
          <h2 class="heading-lg mb-4">Ready to extract frames?</h2>
          <p class="body-md max-w-[500px] mx-auto mb-6">
            Start using our powerful frame extraction tools right now — no registration, no limits, completely free.
          </p>
          <a href="/video-to-image-converter" class="btn-primary inline-flex items-center">
            Start Converting
            <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Add CSS for transitions
        const style = document.createElement('style');
        style.textContent = `
          .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
          }
          .faq-answer.show {
            max-height: 500px;
          }
          .faq-icon {
            transition: transform 0.3s ease;
          }
          .faq-icon.rotate-180 {
            transform: rotate(180deg);
          }
        `;
        document.head.appendChild(style);

        // Initially collapse all answers
        document.querySelectorAll('.faq-answer').forEach(answer => {
          answer.classList.remove('show');
        });

        // FAQ toggle functionality
        window.toggleFaq = function(button) {
          const answer = button.nextElementSibling;
          const icon = button.querySelector('.faq-icon');

          // Close all other open answers
          document.querySelectorAll('.faq-answer').forEach(el => {
            if (el !== answer && el.classList.contains('show')) {
              el.classList.remove('show');
              el.previousElementSibling.querySelector('.faq-icon').classList.remove('rotate-180');
            }
          });

          // Toggle current answer
          answer.classList.toggle('show');
          icon.classList.toggle('rotate-180');
        };
      });
    </script>
</Layout>