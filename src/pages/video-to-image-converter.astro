---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Converter from '../components/converter/preact/Converter.jsx';
---

<Layout>
  <slot name="head">
    <title>Video Frame Extractor & Video to Image Converter - Extract Frames Online Free</title>
    <meta name="description" content="Use our video frame extractor & video to image converter to extract frames from any video using manual capture, interval extraction, or smart scene detection. Save as JPG, PNG, WebP, or AVIF. 100% client-side, no uploads, unlimited conversions.">
    <meta name="keywords" content="video frame extractor, extract frames from video, video to image converter, video frame extraction, online video frame extractor">
    <meta property="og:title" content="Video Frame Extractor & Video to Image Converter - Extract Frames Online Free">
    <meta property="og:description" content="Use our video frame extractor & video to image converter to extract frames from any video using manual capture, interval extraction, or smart scene detection. Save as JPG, PNG, WebP, or AVIF. 100% client-side, no uploads, unlimited conversions.">
    <meta property="og:image" content="/logo.svg">
    <meta property="og:url" content="https://freevideotoimage.com/video-to-image-converter">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Video Frame Extractor & Video to Image Converter - Extract Frames Online Free">
    <meta name="twitter:description" content="Use our video frame extractor & video to image converter to extract frames from any video using manual capture, interval extraction, or smart scene detection. Save as JPG, PNG, WebP, or AVIF. 100% client-side, no uploads, unlimited conversions.">
  </slot>
  <Header currentPath="/video-to-image-converter" />
  <main class="flex-1">
    <section class="py-12 md:py-16 lg:py-20">
      <div class="container">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto mb-10 text-center">
            <p class="eyebrow mb-3">Video Frame Extractor & Image Converter</p>
            <h1 class="heading-lg mb-4">Video Frame Extractor & Video to Image Converter</h1>
            <p class="body-lg text-body max-w-[600px] mx-auto">
              Upload a video and extract frames using our video frame extractor with manual capture, interval extraction, or smart scene detection. Save as JPG, PNG, WebP, or AVIF.
            </p>
            <p class="body-md text-body max-w-[600px] mx-auto mt-4">
              Need a dedicated frame extraction tool? Visit our <a href="/video-frame-extractor" class="text-[var(--color-link)] underline">Video Frame Extractor</a>.
            </p>
          </div>

          <Converter client:visible data-testid="video-converter" />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>