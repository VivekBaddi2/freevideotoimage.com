---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Converter from '../components/converter/preact/Converter.jsx';
---

<Layout>
  <slot name="head">
    <title>Video to Image Converter - Extract Frames from Videos Online Free</title>
    <meta name="description" content="Convert video to image online free. Extract frames from any video using manual capture, interval extraction, or smart scene detection. Save as JPG, PNG, WebP, or AVIF. 100% client-side, no uploads, unlimited conversions.">
    <meta property="og:title" content="Video to Image Converter - Extract Frames from Videos Online Free">
    <meta property="og:description" content="Convert video to image online free. Extract frames from any video using manual capture, interval extraction, or smart scene detection. Save as JPG, PNG, WebP, or AVIF. 100% client-side, no uploads, unlimited conversions.">
    <meta property="og:image" content="/logo.svg">
    <meta property="og:url" content="https://freevideotoimage.com/video-to-image-converter">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Video to Image Converter - Extract Frames from Videos Online Free">
    <meta name="twitter:description" content="Convert video to image online free. Extract frames from any video using manual capture, interval extraction, or smart scene detection. Save as JPG, PNG, WebP, or AVIF. 100% client-side, no uploads, unlimited conversions.">
  </slot>
  <Header currentPath="/video-to-image-converter" />
  <main class="flex-1">
    <section class="py-12 md:py-16 lg:py-20">
      <div class="container">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto mb-10 text-center">
            <p class="eyebrow mb-3">Frame extraction studio</p>
            <h1 class="heading-lg mb-4">Video to Image Converter</h1>
            <p class="body-lg text-body max-w-[600px] mx-auto">
              Upload a video and extract frames using manual capture, interval extraction, or smart scene detection.
            </p>
          </div>

          <Converter client:visible data-testid="video-converter" />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>