---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Hero from '../../components/layout/Hero.astro';
import Footer from '../../components/layout/Footer.astro';
import { getLocaleData } from '../../i18n/locales';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const locale = getLocaleData(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentUrl = `https://freevideotoimage.com/${lang}`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": locale.faq.items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};
---

<Layout lang={lang}>
  <slot name="head">
    <title>{locale.seo.title}</title>
    <meta name="description" content={locale.seo.description} />
    <meta name="keywords" content={locale.seo.keywords} />
    <meta property="og:title" content={locale.seo.title} />
    <meta property="og:description" content={locale.seo.description} />
    <meta property="og:image" content="/logo.svg" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={locale.seo.title} />
    <meta name="twitter:description" content={locale.seo.description} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </slot>

  <Header currentPath="/" lang={lang} />
  
  <main class="flex-1">
    <Hero
      title={locale.hero.title}
      subtitle={locale.hero.subtitle}
      ctaText={locale.hero.cta}
      ctaHref={translatePath('/video-to-image-converter')}
      badge={locale.hero.badge}
      lang={lang}
    />

    {/* Features Section */}
    <section id="features" class="section bg-[var(--color-canvas-elevated)]" aria-labelledby="features-title">
      <div class="container">
        <div class="text-center mx-auto mb-16">
          <span class="eyebrow inline-block mb-4">{locale.features.eyebrow}</span>
          <h2 id="features-title" class="heading-lg mb-4">{locale.features.title}</h2>
          <p class="body-lg">{locale.features.subtitle}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            locale.features.items.map((feature) => (
              <article class="card">
                <h3 class="heading-md mb-3">{feature.title}</h3>
                <p class="body-md">{feature.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* How It Works Section */}
    <section id="how-it-works" class="section" aria-labelledby="how-title">
      <div class="container">
        <div class="text-center mx-auto mb-16">
          <span class="eyebrow inline-block mb-4">{locale.howItWorks.eyebrow}</span>
          <h2 id="how-title" class="heading-lg mb-4">{locale.howItWorks.title}</h2>
          <p class="body-lg">{locale.howItWorks.subtitle}</p>
        </div>
        <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 mx-auto">
          {
            locale.howItWorks.steps.map((step) => (
              <li class="card relative">
                <span class="absolute -top-4 left-6 bg-[var(--color-ink)] text-[var(--color-on-primary)] text-3xl font-bold w-12 h-12 rounded-full flex items-center justify-center">{step.step}</span>
                <div class="pt-8">
                  <h3 class="heading-md mb-3">{step.title}</h3>
                  <p class="body-md">{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* FAQ Section */}
    <section id="faq" class="section bg-[var(--color-canvas-elevated)]" aria-labelledby="faq-title">
      <div class="container">
        <div class="text-center mb-16">
          <span class="eyebrow inline-block mb-4">{locale.faq.eyebrow}</span>
          <h2 id="faq-title" class="heading-lg mb-4">{locale.faq.title}</h2>
        </div>
        <dl class="space-y-4 mx-auto">
          {
            locale.faq.items.map((item) => (
              <div class="card">
                <dt class="heading-md mb-2">{item.q}</dt>
                <dd class="body-md">{item.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {/* SEO Rich Content Section for Ranking */}
    <section id="seo-content" class="section bg-[var(--color-canvas)]">
      <div class="container">
        <div class="text-center mx-auto mb-16">
          <span class="eyebrow inline-block mb-4">{locale.seoContent.eyebrow}</span>
          <h2 class="text-heading-lg font-semibold mb-4">{locale.seoContent.title}</h2>
          <p class="body-lg max-w-[800px] mx-auto">{locale.seoContent.subtitle}</p>
        </div>
        <div class="space-y-6 text-lg mx-auto text-[var(--color-mute)] leading-relaxed">
          {
            locale.seoContent.paragraphs.map((p) => (
              <p>{p}</p>
            ))
          }
        </div>
      </div>
    </section>

    {/* CTA Section */}
    <section class="section" aria-labelledby="cta-title">
      <div class="container text-center">
        <h2 id="cta-title" class="heading-lg mb-4">{t('cta.title')}</h2>
        <p class="body-lg mb-8 mx-auto">{t('cta.subtitle')}</p>
        <a href={translatePath('/video-to-image-converter')} class="btn-primary inline-flex">
          {t('cta.button')}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
