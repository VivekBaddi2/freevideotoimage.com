---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const currentUrl = `https://freevideotoimage.com/${lang}/privacy-policy`;
---

<Layout lang={lang}>
  <slot name="head">
    <title>{t('footer.privacy')} - Free Video to Image Converter</title>
    <meta name="description" content="Privacy Policy for Free Video to Image Converter. 100% client-side tool with zero server uploads." />
    <meta property="og:title" content={`${t('footer.privacy')} - Free Video to Image Converter`} />
    <meta property="og:url" content={currentUrl} />
  </slot>

  <Header currentPath="/privacy-policy" lang={lang} />
  
  <main class="flex-1">
    <section class="page-hero">
      <div class="page-hero-content">
        <div class="container">
          <div class="text-center">
            <p class="eyebrow mb-4">{t('footer.legal')}</p>
            <h1 class="text-2xl md:text-3xl lg:text-5xl tracking-normal">{t('footer.privacy')}</h1>
          </div>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="container max-w-4xl mx-auto">
        <div class="card p-8 md:p-12 rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] space-y-6 text-[var(--color-mute)] leading-relaxed">
          <h2 class="heading-md text-[var(--color-ink)] font-semibold">100% Client-Side Privacy</h2>
          <p>
            Free Video to Image Converter operates entirely within your browser using client-side JavaScript and HTML5 Canvas APIs. 
            Your video files are processed locally on your device and are never uploaded, transmitted, or stored on our servers.
          </p>
          <h2 class="heading-md text-[var(--color-ink)] font-semibold">No Data Collection on Videos</h2>
          <p>
            Because video processing is strictly client-side, we have no access to your video files, image frames, or extracted metadata. 
            Your content remains strictly confidential.
          </p>
          <h2 class="heading-md text-[var(--color-ink)] font-semibold">Cookies & Analytics</h2>
          <p>
            We use standard, anonymized analytics (such as Google Analytics) solely to understand overall website traffic and improve user experience. No personal video data is ever tied to analytics.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
