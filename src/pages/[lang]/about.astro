---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getLocaleData } from '../../i18n/locales';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const locale = getLocaleData(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentUrl = `https://freevideotoimage.com/${lang}/about`;
---

<Layout lang={lang}>
  <slot name="head">
    <title>{t('nav.about')} - Free Video to Image Converter</title>
    <meta name="description" content={`Learn about FreeVideoToImage.com, a privacy-focused client-side video to image converter.`} />
    <meta property="og:title" content={`${t('nav.about')} - Free Video to Image Converter`} />
    <meta property="og:description" content={`Learn about FreeVideoToImage.com, a privacy-focused client-side video to image converter.`} />
    <meta property="og:image" content="/logo.svg" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </slot>

  <Header currentPath="/about" lang={lang} />
  
  <main class="flex-1">
    <section class="page-hero">
      <div class="page-hero-content">
        <div class="container">
          <div class="text-center">
            <p class="eyebrow mb-4">{t('pill.private')}</p>
            <h1 class="text-2xl md:text-3xl lg:text-5xl tracking-normal">{t('nav.about')} FreeVideoToImage.com</h1>
            <p class="body-lg max-w-[600px] mx-auto text-center mt-4 text-[var(--color-mute)]">
              {locale.seoContent.subtitle}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="container max-w-4xl mx-auto space-y-8">
        <div class="card p-8 rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)]">
          <h2 class="heading-md mb-4 text-[var(--color-brand)]">{t('pill.clientSide')}</h2>
          <div class="space-y-4 body-md text-[var(--color-mute)] leading-relaxed">
            {
              locale.seoContent.paragraphs.map((p) => (
                <p>{p}</p>
              ))
            }
          </div>
        </div>

        <div class="text-center pt-8">
          <a href={translatePath('/video-to-image-converter')} class="btn-primary inline-flex">
            {t('hero.cta')}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
