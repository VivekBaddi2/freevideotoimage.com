---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { getLocaleData } from "../../i18n/locales";
import { useTranslations, useTranslatedPath } from "../../i18n/utils";
import type { SupportedLanguage } from "../../i18n/ui";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "ja" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
    { params: { lang: "pt" } },
    { params: { lang: "ko" } },
    { params: { lang: "it" } },
    { params: { lang: "hi" } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const locale = getLocaleData(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentUrl = `https://freevideotoimage.com/${lang}/faq`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: locale.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<Layout lang={lang}>
  <slot name="head">
    <title>
      {locale.faq.title} - Video to Image Converter | FreeVideoToImage.com
    </title>
    <meta
      name="description"
      content={`Frequently asked questions about Free Video to Image Converter in ${lang}.`}
    />
    <meta
      property="og:title"
      content={`${locale.faq.title} - Video to Image Converter | FreeVideoToImage.com`}
    />
    <meta
      property="og:description"
      content={`Frequently asked questions about Free Video to Image Converter in ${lang}.`}
    />
    <meta property="og:image" content="/logo.svg" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={`${locale.faq.title} - Video to Image Converter | FreeVideoToImage.com`}
    />
    <meta
      name="twitter:description"
      content={`Frequently asked questions about Free Video to Image Converter in ${lang}.`}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </slot>

  <Header currentPath="/faq" lang={lang} />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative">
      <div class="relative z-10 pt-20 pb-16 md:pt-28 md:pb-20">
        <div class="container">
          <div class="text-center">
            <h1 class="text-xl font-semibold mb-3 text-center">
              {locale.faq.title}
            </h1>
            <p class="body-lg max-w-[600px] mx-auto text-center">
              {locale.faq.subtitle || t("faq.subtitle")}
            </p>
          </div>
        </div>
      </div>
      <!-- Mesh Gradient Background -->
      <div class="absolute inset-0 -z-0 pointer-events-none">
        <svg
          width="100%"
          height="100%"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
        >
          <defs>
            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="{colors.cyan}"></stop>
              <stop offset="25%" stop-color="{colors.violet}"></stop>
              <stop offset="50%" stop-color="{colors.pink}"></stop>
              <stop offset="75%" stop-color="{colors.magenta}"></stop>
              <stop offset="100%" stop-color="{colors.cyan}"></stop>
            </linearGradient>
          </defs>
          <rect width="100" height="100" fill="url(#gradient)" opacity="0.08"
          ></rect>
        </svg>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="pt-16 md:pt-20 pb-12">
      <div class="container">
        <div class="text-center mb-16">
          <span class="mono-eyebrow mb-3"
            >{locale.faq.eyebrow || t("faq.eyebrow")}</span
          >
          <h2 class="heading-lg mb-4 text-center">
            {locale.faq.heading || t("faq.heading")}
          </h2>
        </div>
        <div class="max-w-[800px] mx-auto space-y-4">
          {
            locale.faq.items.map((item) => (
              <div class="faq-item border-b border-[var(--color-hairline)] pb-4 last:border-b-0 last:pb-0">
                <button
                  class="faq-question w-full text-left flex items-center justify-between text-[var(--color-ink)] font-medium hover:text-[var(--color-primary)] transition-colors"
                  onclick="toggleFaq(this)"
                >
                  {item.q}
                  <svg
                    class="faq-icon w-5 h-5 transition-transform"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div class="faq-answer mt-2 text-[var(--color-body)]">
                  {item.a}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="pt-12 md:pt-16 pb-10 bg-[var(--color-canvas-elevated)]">
      <div class="container">
        <div class="text-center">
          <h2 class="heading-lg mb-4">{t("cta.title")}</h2>
          <p class="body-md max-w-[500px] mx-auto mb-6">
            {t("cta.subtitle")}
          </p>
          <a
            href={translatePath("/video-to-image-converter")}
            class="btn-primary inline-flex items-center"
          >
            {t("cta.button")}
            <svg
              class="ml-2 w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // Add CSS for transitions
      const style = document.createElement("style");
      style.textContent = `
        .faq-answer {
          max-height: 0;
          overflow: hidden;
          transition: max-height 0.3s ease-out;
        }
        .faq-answer.show {
          max-height: 500px;
        }
        .faq-icon {
          transition: transform 0.3s ease;
        }
        .faq-icon.rotate-180 {
          transform: rotate(180deg);
        }
      `;
      document.head.appendChild(style);

      // Initially collapse all answers
      document.querySelectorAll(".faq-answer").forEach((answer) => {
        answer.classList.remove("show");
      });

      // FAQ toggle functionality
      function toggleFaq(button: HTMLButtonElement) {
        const answer = button.nextElementSibling;
        const icon = button.querySelector(".faq-icon");

        if (!answer || !icon) return;

        // Close all other open answers
        document.querySelectorAll(".faq-answer").forEach((el) => {
          if (el !== answer && el.classList.contains("show")) {
            el.classList.remove("show");
            el.previousElementSibling
              ?.querySelector(".faq-icon")
              ?.classList.remove("rotate-180");
          }
        });

        // Toggle current answer
        answer.classList.toggle("show");
        icon.classList.toggle("rotate-180");
      }

      (
        window as unknown as Window & {
          toggleFaq: (button: HTMLButtonElement) => void;
        }
      ).toggleFaq = toggleFaq;
    });
  </script>
</Layout>
