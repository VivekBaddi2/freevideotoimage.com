---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getLocaleData } from '../../i18n/locales';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const locale = getLocaleData(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentUrl = `https://freevideotoimage.com/${lang}/faq`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": locale.faq.items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};
---

<Layout lang={lang}>
  <slot name="head">
    <title>{locale.faq.title} - Free Video to Image Converter</title>
    <meta name="description" content={`Frequently asked questions about Free Video to Image Converter in ${lang}.`} />
    <meta property="og:title" content={locale.faq.title} />
    <meta property="og:description" content={`Frequently asked questions about Free Video to Image Converter in ${lang}.`} />
    <meta property="og:image" content="/logo.svg" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={locale.faq.title} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </slot>

  <Header currentPath="/faq" lang={lang} />
  
  <main class="flex-1">
    <section class="page-hero">
      <div class="page-hero-content">
        <div class="container">
          <div class="text-center">
            <p class="eyebrow mb-4">{locale.faq.eyebrow}</p>
            <h1 class="text-2xl md:text-3xl lg:text-5xl tracking-normal">{locale.faq.title}</h1>
          </div>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="container max-w-4xl mx-auto">
        <dl class="space-y-6">
          {
            locale.faq.items.map((item) => (
              <div class="card p-6 rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] shadow-sm">
                <dt class="heading-md mb-2 text-[var(--color-ink)] font-semibold">{item.q}</dt>
                <dd class="body-md text-[var(--color-mute)] leading-relaxed">{item.a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="page-section bg-[var(--color-canvas-elevated)]">
      <div class="container text-center">
        <h2 class="heading-lg mb-4">{t('cta.title')}</h2>
        <p class="body-lg mb-8 max-w-[600px] mx-auto">{t('cta.subtitle')}</p>
        <a href={translatePath('/video-to-image-converter')} class="btn-primary inline-flex">
          {t('cta.button')}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
