---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getLocaleData } from '../../i18n/locales';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const locale = getLocaleData(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentUrl = `https://freevideotoimage.com/${lang}/features`;
---

<Layout lang={lang}>
  <slot name="head">
    <title>{locale.features.title} - Free Video to Image Converter</title>
    <meta name="description" content={locale.features.subtitle} />
    <meta property="og:title" content={locale.features.title} />
    <meta property="og:description" content={locale.features.subtitle} />
    <meta property="og:image" content="/logo.svg" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={locale.features.title} />
    <meta name="twitter:description" content={locale.features.subtitle} />
  </slot>

  <Header currentPath="/features" lang={lang} />
  
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-hero-content">
        <div class="container">
          <div class="text-center">
            <p class="eyebrow mb-4">{locale.features.eyebrow}</p>
            <h1 class="text-2xl md:text-3xl lg:text-5xl tracking-normal">{locale.features.title}</h1>
            <p class="body-lg max-w-[600px] mx-auto text-center">
              {locale.features.subtitle}
            </p>
          </div>
        </div>
      </div>
      <!-- Mesh Gradient Background -->
      <div class="absolute inset-0 -z-0 pointer-events-none">
        <svg width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
          <defs>
            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="{colors.cyan}" />
              <stop offset="25%" stop-color="{colors.violet}" />
              <stop offset="50%" stop-color="{colors.pink}" />
              <stop offset="75%" stop-color="{colors.magenta}" />
              <stop offset="100%" stop-color="{colors.cyan}" />
            </linearGradient>
          </defs>
          <rect width="100" height="100" fill="url(#gradient)" opacity="0.08" />
        </svg>
      </div>
    </section>

    <!-- SEO Content Section -->
    <section class="page-section bg-[var(--color-canvas-elevated)]">
      <div class="container">
        <div class="section-heading">
          <span class="mono-eyebrow mb-3">{locale.features.seo.eyebrow}</span>
          <h2 class="heading-lg mb-4 text-center">{locale.features.seo.title}</h2>
          <p class="body-md max-w-[600px] mx-auto text-center">
            {locale.features.seo.subtitle}
          </p>
        </div>
        <div class="editorial-copy">
          <p>{locale.features.seo.paragraph1}</p>
          <p>{locale.features.seo.paragraph2}</p>
          <p>{locale.features.seo.paragraph3}</p>
          <p>{locale.features.seo.paragraph4}</p>
          <p>{locale.features.seo.paragraph5}</p>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="page-section">
      <div class="container">
        <div class="section-heading">
          <span class="mono-eyebrow mb-3">{locale.features.gridEyebrow}</span>
          <h2 class="heading-lg mb-4 text-center">{locale.features.gridTitle}</h2>
          <p class="body-md max-w-[500px] mx-auto text-center">
            {locale.features.gridSubtitle}
          </p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            locale.features.items.map((feature) => (
              <article class="feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow">
                <div class="space-y-4">
                  <h3 class="heading-md mb-2">{feature.title}</h3>
                  <p class="body-md">{feature.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Technical Details -->
    <section class="page-section bg-[var(--color-canvas-elevated)]">
      <div class="container">
        <div class="section-heading">
          <span class="mono-eyebrow mb-3">{locale.features.tech.eyebrow}</span>
          <h2 class="heading-lg mb-4 text-center">{locale.features.tech.title}</h2>
        </div>
        <div class="grid gap-8 md:grid-cols-2">
          <div class="space-y-6">
            <h3 class="heading-md mb-3">{locale.features.tech.highPerformance.title}</h3>
            <p class="body-md">{locale.features.tech.highPerformance.desc}</p>
          </div>
          <div class="space-y-6">
            <h3 class="heading-md mb-3">{locale.features.tech.formatSupport.title}</h3>
            <p class="body-md">{locale.features.tech.formatSupport.desc}</p>
          </div>
          <div class="space-y-6">
            <h3 class="heading-md mb-3">{locale.features.tech.privacyFirst.title}</h3>
            <p class="body-md">{locale.features.tech.privacyFirst.desc}</p>
          </div>
          <div class="space-y-6">
            <h3 class="heading-md mb-3">{locale.features.tech.noLimits.title}</h3>
            <p class="body-md">{locale.features.tech.noLimits.desc}</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>