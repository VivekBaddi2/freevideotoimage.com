---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const currentUrl = `https://freevideotoimage.com/${lang}/contact-us`;
---

<Layout lang={lang}>
  <slot name="head">
    <title>{t('footer.contact')} - Free Video to Image Converter</title>
    <meta name="description" content="Contact the Free Video to Image Converter team for feedback, support, or inquiries." />
    <meta property="og:title" content={`${t('footer.contact')} - Free Video to Image Converter`} />
    <meta property="og:url" content={currentUrl} />
  </slot>

  <Header currentPath="/contact-us" lang={lang} />
  
  <main class="flex-1">
    <section class="page-hero">
      <div class="page-hero-content">
        <div class="container">
          <div class="text-center">
            <p class="eyebrow mb-4">{t('footer.contact')}</p>
            <h1 class="text-2xl md:text-3xl lg:text-5xl tracking-normal">{t('footer.contact')}</h1>
          </div>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="container max-w-2xl mx-auto">
        <div class="card p-8 rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] space-y-6">
          <p class="body-md text-[var(--color-mute)]">
            We value your feedback and questions. Please feel free to reach out to our team at:
          </p>
          <div class="p-4 rounded-xl bg-[var(--color-canvas)] border border-[var(--color-hairline)]">
            <span class="text-xs uppercase tracking-wider text-[var(--color-mute)] font-semibold block mb-1">Email</span>
            <a href="mailto:support@freevideotoimage.com" class="text-lg font-medium text-[var(--color-brand)] hover:underline">
              support@freevideotoimage.com
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
