---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getLocaleData } from '../../i18n/locales';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const locale = getLocaleData(lang);
const currentUrl = `https://freevideotoimage.com/${lang}/contact-us`;

const contactData = locale.contactPage;
---

<Layout lang={lang}>
  <slot name="head">
    <title>{contactData.meta?.title}</title>
    <meta name="description" content={contactData.meta?.description} />
    <meta property="og:title" content={contactData.meta?.openGraph?.title || contactData.meta?.title} />
    <meta property="og:description" content={contactData.meta?.openGraph?.description || contactData.meta?.description} />
    <meta property="og:image" content={contactData.meta?.openGraph?.image || "/logo.svg"} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content={contactData.meta?.openGraph?.type || "website"} />
    <meta name="twitter:card" content={contactData.meta?.twitter?.card || "summary_large_image"} />
    <meta name="twitter:title" content={contactData.meta?.twitter?.title || contactData.meta?.title} />
    <meta name="twitter:description" content={contactData.meta?.twitter?.description || contactData.meta?.description} />
  </slot>

  <Header currentPath="/contact-us" lang={lang} />

  <main class="flex-1">
    <section class="pt-16 md:pt-20 pb-20 bg-[var(--color-canvas-elevated)]">
      <div class="container">
        <!-- Hero Section -->
        <div class="text-center mb-14 max-w-[640px] mx-auto">
          {contactData.heroSection?.badge && (
            <span class="inline-block text-xs font-semibold tracking-wide uppercase text-[var(--color-link)] mb-3">
              {contactData.heroSection.badge}
            </span>
          )}
          <h1 class="text-2xl font-bold md:text-3xl mb-4">{contactData.heroSection?.heading}</h1>
          <p class="body-lg text-[var(--color-mute)]">
            {contactData.heroSection?.subheading}
          </p>
        </div>

        <!-- Cards Section -->
        <div class="grid gap-6 md:grid-cols-2 max-w-[880px] mx-auto">
          {contactData.cards?.map((card) => (
            <div class="rounded-2xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-8 shadow-sm">
              <h2 class="heading-md mb-6">{card.heading}</h2>

              {/* Render Contact Type Card (Email/Details) */}
              {card.type === 'contact' && card.details && (
                <div class="space-y-5">
                  {card.details.map((detail) => (
                    <a
                      href={detail.link}
                      class="group flex items-start gap-4 rounded-xl p-3 -m-3 transition-colors hover:bg-[var(--color-canvas-elevated)]"
                    >
                      <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-link-soft)] text-[var(--color-link)]">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                          <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                      </span>
                      <div>
                        <h3 class="heading-sm mb-0.5">{detail.label}</h3>
                        <p class="body-md text-[var(--color-mute)] group-hover:text-[var(--color-ink)] transition-colors break-all">
                          {detail.value}
                        </p>
                      </div>
                    </a>
                  ))}
                </div>
              )}

              {/* Render Statement Type Card (Privacy/Info) */}
              {card.type === 'statement' && (
                <div class="flex items-start gap-4">
                  <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-[var(--color-cyan-soft)] text-[var(--color-cyan)]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                  </span>
                  <p class="body-md text-[var(--color-mute)]" set:html={card.description} />
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>