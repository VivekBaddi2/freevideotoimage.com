---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import { getLocaleData } from "../../i18n/locales";
import type { SupportedLanguage } from "../../i18n/ui";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "ja" } },
    { params: { lang: "fr" } },
    { params: { lang: "de" } },
    { params: { lang: "pt" } },
    { params: { lang: "ko" } },
    { params: { lang: "it" } },
    { params: { lang: "hi" } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const locale = getLocaleData(lang);
const currentUrl = `https://freevideotoimage.com/${lang}/terms-conditions`;

const termsData = locale.termsPage;
---

<Layout lang={lang}>
  <slot name="head">
    <title>{termsData?.meta?.title || `${termsData?.title} - FreeVideoToImage.com`}</title>
    <meta
      name="description"
      content={termsData?.meta?.description || "Terms and Conditions for FreeVideoToImage.com. Please read these terms carefully before using our video to image converter service."}
    />
    <meta
      property="og:title"
      content={termsData?.meta?.openGraph?.title || `${termsData?.title} - FreeVideoToImage.com`}
    />
    <meta
      property="og:description"
      content={termsData?.meta?.openGraph?.description || "Terms and Conditions for FreeVideoToImage.com. Please read these terms carefully before using our video to image converter service."}
    />
    <meta property="og:image" content={termsData?.meta?.openGraph?.image || "/logo.svg"} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content={termsData?.meta?.openGraph?.type || "website"} />
    <meta name="twitter:card" content={termsData?.meta?.twitter?.card || "summary_large_image"} />
    <meta
      name="twitter:title"
      content={termsData?.meta?.twitter?.title || `${termsData?.title} - FreeVideoToImage.com`}
    />
    <meta
      name="twitter:description"
      content={termsData?.meta?.twitter?.description || "Terms and Conditions for FreeVideoToImage.com. Please read these terms carefully before using our video to image converter service."}
    />
  </slot>

  <Header currentPath="/terms-conditions" lang={lang} />

  <main class="flex-1">
    <section class="pt-16 md:pt-20 pb-12">
      <div class="container">
        <!-- Header / Hero Section -->
        <div class="text-center mb-12">
          <h1 class="text-xl font-semibold mb-4 text-center">
            {termsData?.title}
          </h1>
          {termsData?.effectiveDate && (
            <p class="body-lg max-w-[600px] mx-auto text-center">
              Effective date: {termsData.effectiveDate}
            </p>
          )}
        </div>

        <!-- Terms Sections -->
        <div class="prose lg:prose-xl mx-auto max-w-none">
          {termsData?.sections?.map((section) => (
            <div class="mb-8">
              {section.heading && (
                <h2 class="heading-lg mb-4">{section.heading}</h2>
              )}
              
              {section.content?.map((paragraph) => (
                <p set:html={paragraph} />
              ))}

              {section.listItems && section.listItems.length > 0 && (
                <ul class="list-disc list-inside space-y-2">
                  {section.listItems.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>