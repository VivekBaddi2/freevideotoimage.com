---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Converter from '../../components/converter/preact/Converter.jsx';
import { getLocaleData } from '../../i18n/locales';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
    { params: { lang: 'hi' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const locale = getLocaleData(lang);
const tool = locale.tools.videoToJpg;
const currentUrl = `https://freevideotoimage.com/${lang}/video-to-jpg`;
---

<Layout lang={lang}>
  <slot name="head">
    <title>{tool.metaTitle}</title>
    <meta name="description" content={tool.metaDescription} />
    <meta property="og:title" content={tool.metaTitle} />
    <meta property="og:description" content={tool.metaDescription} />
    <meta property="og:image" content="/logo.svg" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tool.metaTitle} />
    <meta name="twitter:description" content={tool.metaDescription} />
  </slot>
  <Header currentPath="/video-to-jpg" lang={lang} />
  <main class="flex-1">
    <section class="py-12 md:py-16 lg:py-20">
      <div class="container">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto mb-10 text-center">
            <p class="eyebrow mb-3">{tool.eyebrow}</p>
            <h1 class="heading-lg mb-4">{tool.title}</h1>
            <p class="body-lg text-body max-w-[600px] mx-auto">
              {tool.description}
            </p>
          </div>

          <Converter client:visible data-testid="video-converter" />
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
