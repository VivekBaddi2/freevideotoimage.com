---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout>
  <slot name="head">
    <title>Server Error - FreeVideoToImage.com</title>
    <meta name="description" content="Something went wrong on our end. Please try again later.">
    <meta property="og:title" content="Server Error - FreeVideoToImage.com">
    <meta property="og:description" content="Something went wrong on our end. Please try again later.">
    <meta property="og:image" content="/logo.svg">
    <meta property="og:url" content="https://freevideotoimage.com/500">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Server Error - FreeVideoToImage.com">
    <meta name="twitter:description" content="Something went wrong on our end. Please try again later.">
  </slot>
  <Header currentPath="/500" />
  <main class="flex-1">
    <section class="pt-16 md:pt-20 pb-12">
      <div class="container">
        <div class="text-center">
          <h1 class="text-3xl font-bold mb-6">500</h1>
          <p class="heading-lg mb-6">Internal Server Error</p>
          <p class="body-lg max-w-[500px] mx-auto mb-8 text-[var(--color-mute)]">
            Something went wrong on our end. Please try again later or <a href="/" class="underline">contact us</a> if the problem persists.
          </p>
          <a href="/" class="btn-primary inline-flex items-center">
            Go to Homepage
            <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>