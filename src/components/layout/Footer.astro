---
import { languages, type SupportedLanguage } from "../../i18n/ui";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";

interface Props {
  lang?: SupportedLanguage;
}

const currentYear = new Date().getFullYear();
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentPathname = Astro.url.pathname;
---

<footer
  class="border-t border-[var(--color-hairline)] bg-[var(--color-canvas)]"
  role="contentinfo"
>
  <div class="container py-16 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12">
      <div class="md:col-span-1">
        <a
          href={translatePath("/")}
          aria-label="Video to Image Converter - Home"
          class="flex gap-2 items-center"
        >
          <img
            src="/logo.svg"
            alt="Free Video to Image Converter Logo"
            class="h-[36px] rounded-lg w-auto"
          />
          <span class="text-md md:text-lg text-[var(--color-ink)] font-semibold"
            >Free Video to Image</span
          >
        </a>
        <p class="mt-2 body-md">
          {t("footer.description")}
        </p>
      </div>

      <nav aria-label="Navigation">
        <h3 class="eyebrow mb-3">{t("footer.navigation")}</h3>
        <ul class="space-y-2">
          <li>
            <a
              href={translatePath("/")}
              class="body-md hover:text-[var(--color-ink)]">{t("nav.home")}</a
            >
          </li>
          <li>
            <a
              href={translatePath("/about")}
              class="body-md hover:text-[var(--color-ink)]">{t("nav.about")}</a
            >
          </li>
          <li>
            <a
              href={translatePath("/features")}
              class="body-md hover:text-[var(--color-ink)]"
              >{t("nav.features")}</a
            >
          </li>
          <li>
            <a
              href={translatePath("/how-it-works")}
              class="body-md hover:text-[var(--color-ink)]"
              >{t("nav.howItWorks")}</a
            >
          </li>
          <li>
            <a
              href={translatePath("/blogs")}
              class="body-md hover:text-[var(--color-ink)]">{t("nav.blogs")}</a
            >
          </li>
          <li>
            <a
              href={translatePath("/faq")}
              class="body-md hover:text-[var(--color-ink)]">{t("nav.faq")}</a
            >
          </li>
          <li>
            <a
              href={translatePath("/contact-us")}
              class="body-md hover:text-[var(--color-ink)]"
              >{t("footer.contact")}</a
            >
          </li>
        </ul>
      </nav>

      <nav aria-label="Legal">
        <h3 class="eyebrow mb-3">{t("footer.legal")}</h3>
        <ul class="space-y-2">
          <li>
            <a
              href={translatePath("/privacy-policy")}
              class="body-md hover:text-[var(--color-ink)]"
              >{t("footer.privacy")}</a
            >
          </li>
          <li>
            <a
              href={translatePath("/terms-conditions")}
              class="body-md hover:text-[var(--color-ink)]"
              >{t("footer.terms")}</a
            >
          </li>
        </ul>
      </nav>

      <nav aria-label="Tools">
        <h3 class="eyebrow mb-3">{t("footer.tools")}</h3>
        <ul class="space-y-2">
          <li>
            <a
              href={translatePath("/video-to-image-converter")}
              class="body-md hover:text-[var(--color-ink)]"
              >Video to Image Converter</a
            >
          </li>
          <li>
            <a
              href={translatePath("/video-to-jpg")}
              class="body-md hover:text-[var(--color-ink)]">Video to JPG</a
            >
          </li>
          <li>
            <a
              href={translatePath("/video-to-png")}
              class="body-md hover:text-[var(--color-ink)]">Video to PNG</a
            >
          </li>
          <li>
            <a
              href={translatePath("/video-screenshot-tool")}
              class="body-md hover:text-[var(--color-ink)]"
              >Video Screenshot Tool</a
            >
          </li>
          <li>
            <a
              href={translatePath("/video-frame-extractor")}
              class="body-md hover:text-[var(--color-ink)]"
              >Video Frame Extractor</a
            >
          </li>
        </ul>
      </nav>
    </div>

    {/* Language links for SEO and international users */}
    <div class="mt-12 pt-8 border-t border-[var(--color-hairline)]">
      <div
        class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-[var(--color-mute)]"
      >
        <span class="font-medium text-[var(--color-ink)]"
          >{t("lang.select")}:</span
        >
        {
          Object.entries(languages).map(([langCode, label]) => {
            const targetUrl = translatePath(
              currentPathname,
              langCode as SupportedLanguage,
            );
            const isCurrent = langCode === lang;
            return (
              <a
                href={targetUrl}
                class={`hover:text-[var(--color-ink)] transition-colors ${
                  isCurrent
                    ? "font-semibold text-[var(--color-brand)] underline"
                    : ""
                }`}
                hreflang={langCode}
                lang={langCode}
              >
                {label}
              </a>
            );
          })
        }
      </div>
    </div>

    <div
      class="mt-6 pt-6 border-t border-[var(--color-hairline)] flex flex-col md:flex-row items-center justify-between gap-4"
    >
      <p class="body-sm text-[var(--color-mute)]">
        &copy; {currentYear} Free Video to Image. {t("footer.rights")}
      </p>
      <p class="body-sm text-[var(--color-mute)]">
        100% Client-Side. Your videos never leave your device.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-end gap-4 mt-8">
      <a
        href="https://launch-list.org/product/free-video-to-image-converter-video-frame-extractor"
        target="_blank"
        style="display: block; width: fit-content;"
      >
        <img
          src="https://launch-list.org/badges/svg/launch_list_badge_live.svg"
          alt="Launch List Badge"
          style="height: 50px;"
        />
      </a>
      <a
        href="https://launchnest.io/p/video-to-image-converter"
        target="_blank"
      >
        <img
          src="https://launchnest.io/badge/video-to-image-converter.svg?variant=featured"
          alt="Video to Image Converter on LaunchNest"
          width="220"
          height="56"
        />
      </a>
    </div>
  </div>
</footer>
