---
const currentYear = new Date().getFullYear();
---

<footer
  class="border-t border-[var(--color-hairline)] bg-[var(--color-canvas)]"
  role="contentinfo"
>
  <div class="container py-16 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-12">
      <div class="md:col-span-1">
        <a
          href="/"
          aria-label="Video to Image Converter - Home"
          class="flex gap-3 items-center"
        >
          <img
            src="/logo.svg"
            alt="Free Video to Image Converter Logo"
            class="h-[20px] w-auto"
          />
          <span class="text-md md:text-lg text-[var(--color-ink)] font-semibold"
            >Free Video to Image</span
          >
        </a>
        <p class="mt-2 body-md">
          Extract frames from any video. Client-side, private, free. No uploads,
          no limits.
        </p>
      </div>

      <nav aria-label="Product">
        <h3 class="eyebrow mb-3">Product</h3>
        <ul class="space-y-2">
          <li>
            <a href="/features" class="body-md hover:text-[var(--color-ink)]"
              >Features</a>
          </li>
          <li>
            <a
              href="/how-it-works"
              class="body-md hover:text-[var(--color-ink)]">How it Works</a>
          </li>
          <li>
            <a href="/faq" class="body-md hover:text-[var(--color-ink)]">FAQ</a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Legal">
        <h3 class="eyebrow mb-3">Legal</h3>
        <ul class="space-y-2">
          <li>
            <a href="/privacy" class="body-md hover:text-[var(--color-ink)]"
              >Privacy Policy</a>
          </li>
          <li>
            <a href="/terms" class="body-md hover:text-[var(--color-ink)]"
              >Terms of Service</a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Tools">
        <h3 class="eyebrow mb-3">Tools</h3>
        <ul class="space-y-2">
          <li>
            <a
              href="/video-to-image-converter"
              class="body-md hover:text-[var(--color-ink)]"
              >Video to Image Converter</a>
          </li>
          <li>
            <a
              href="/video-to-jpg"
              class="body-md hover:text-[var(--color-ink)]">Video to JPG</a>
          </li>
          <li>
            <a
              href="/video-to-png"
              class="body-md hover:text-[var(--color-ink)]">Video to PNG</a>
          </li>
          <li>
            <a
              href="/video-screenshot-tool"
              class="body-md hover:text-[var(--color-ink)]"
              >Video Screenshot Tool</a>
          </li>
          <li>
            <a
              href="/video-frame-extractor"
              class="body-md hover:text-[var(--color-ink)]"
              >Video Frame Extractor</a>
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-12 pt-8 border-t border-[var(--color-hairline)] flex flex-col md:flex-row items-center justify-between gap-4"
    >
      <p class="body-sm text-[var(--color-mute)]">
        &copy; {currentYear} Video to Image Converter. All rights reserved.
      </p>
      <p class="body-sm text-[var(--color-mute)]">
        Processed entirely in your browser. Your videos never leave your device.
      </p>
    </div>
  </div>
</footer>
