---
/**
 * @typedef {Object} Props
 * @property {string} [currentPath='/']
 */

const { currentPath = '/' } = Astro.props;
---

<header class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] sticky top-0 z-50">
  <div class="container">
    <nav class="flex items-center justify-between h-16" aria-label="Main navigation">
      <a href="/" class="font-sans text-[var(--text-heading-md)] font-semibold text-[var(--color-ink)]" aria-label="Video to Image Converter - Home">
        Video to Image
      </a>

      <div class="hidden md:flex items-center gap-2">
        <a href="/#features" class="btn-ghost" aria-current={currentPath === '/' || currentPath === '/#features' ? 'page' : undefined}>
          Features
        </a>
        <a href="/#how-it-works" class="btn-ghost">
          How it Works
        </a>
        <a href="/#faq" class="btn-ghost">
          FAQ
        </a>
      </div>

      <div class="flex items-center gap-3">
        <a href="/converter" class="btn-primary hidden sm:inline-flex">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="17 8 12 3 7 8" />
          <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
          Convert
        </a>
      </div>
    </nav>
  </div>
</header>