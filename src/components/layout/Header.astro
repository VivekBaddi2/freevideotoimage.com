---
/**
 * @typedef {Object} Props
 * @property {string} [currentPath='/']
 */

const { currentPath = "/" } = Astro.props;
---

<header
  class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] sticky top-0 z-50"
>
  <div class="container">
    <nav
      class="flex items-center justify-between h-16"
      aria-label="Main navigation"
    >
      <a
        href="/"
        aria-label="Video to Image Converter - Home"
        class="flex gap-2 items-center"
      >
        <img
          src="/logo.svg"
          alt="Free Video to Image Converter Logo"
          class="h-[36px] rounded-lg w-auto"
        />
        <span class="text-md md:text-lg text-[var(--color-ink)] font-semibold"
          >Free Video to Image</span
        >
      </a>

      <div class="flex items-center justify-center gap-4">
        {/* Desktop nav links: hidden on mobile */}
        <div class="hidden lg:flex items-center gap-2">
          <a
            href="/"
            class="btn-ghost"
            aria-current={currentPath === "/" ? "page" : undefined}
          >
            Home
          </a>
          <a
            href="/about"
            class="btn-ghost"
            aria-current={currentPath === "/" ? "page" : undefined}
          >
            About
          </a>
          <a
            href="/features"
            class="btn-ghost"
            aria-current={currentPath === "/features" ? "page" : undefined}
          >
            Features
          </a>
          <a
            href="/how-it-works"
            class="btn-ghost"
            aria-current={currentPath === "/how-it-works" ? "page" : undefined}
          >
            How it Works
          </a>
          <a
            href="/faq"
            class="btn-ghost"
            aria-current={currentPath === "/faq" ? "page" : undefined}
          >
            FAQ
          </a>
          <a
            href="/tools"
            class="btn-ghost"
            aria-current={currentPath === "/tools" ? "page" : undefined}
          >
            Tools
          </a>
          <a
            href="/blogs"
            class="btn-ghost"
            aria-current={currentPath === "/tools" ? "page" : undefined}
          >
            Blogs
          </a>
          {/* Dark mode toggle */}
          <button
            id="dark-mode-toggle"
            class="btn-ghost-sm ml-4"
            aria-label="Toggle dark mode"
          >
            <!-- Moon icon (show by default) -->
            <svg
              class="moon-icon h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <!-- Sun icon (hidden by default) -->
            <svg
              class="sun-icon hidden h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="5.64" y1="18.36" x2="4.22" y2="19.78"></line>
              <line x1="19.78" y1="5.64" x2="18.36" y2="4.22"></line>
            </svg>
          </button>
        </div>

        {/* Dark mode toggle for mobile */}
        <button
          id="dark-mode-toggle-mobile"
          class="lg:hidden btn-ghost-sm "
          aria-label="Toggle dark mode"
        >
          <!-- Moon icon (show by default) -->
          <svg
            class="moon-icon h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <!-- Sun icon (hidden by default) -->
          <svg
            class="sun-icon hidden h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="5.64" y1="18.36" x2="4.22" y2="19.78"></line>
            <line x1="19.78" y1="5.64" x2="18.36" y2="4.22"></line>
          </svg>
        </button>

        {/* Mobile hamburger button: hidden on desktop */}
        <button
          id="mobile-menu-button"
          class="lg:hidden p-2"
          aria-label="Open main menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 6h18"></path>
            <path d="M3 12h18"></path>
            <path d="M3 18h18"></path>
          </svg>
        </button>
      </div>

        <div class="hidden lg:flex items-center gap-3">
          <a
            href="/video-to-image-converter"
            class="btn-primary hidden sm:inline-flex"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2 2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            Convert
          </a>
        </div>
    </nav>
    {/* Mobile menu */}
    <div
      id="mobile-menu"
      class="pointer-events-none absolute left-0 right-0 top-full z-40 -translate-y-2 border-b border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] opacity-0 shadow-[0px_8px_20px_-12px_rgba(0,0,0,0.3)] transition-[opacity,transform] duration-200 ease-out lg:hidden"
      aria-hidden="true"
    >
      <div class="container py-4">
        {/* Close button */}
        {/* Menu links */}
        <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
          <a href="/" class="btn-ghost justify-start">Home</a>
          <a href="/about" class="btn-ghost justify-start">About</a>
          <a href="/features" class="btn-ghost justify-start">Features</a>
          <a href="/how-it-works" class="btn-ghost justify-start"
            >How it Works</a
          >
          <a href="/faq" class="btn-ghost justify-start">FAQ</a>
          <a href="/tools" class="btn-ghost justify-start">Tools</a>
          <a href="/blogs" class="btn-ghost justify-start">Blogs</a>
          <a href="/video-to-image-converter" class="btn-primary mt-2 w-full"
            >Convert</a
          >
        </nav>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Mobile menu variables
        const mobileMenuButton = document.getElementById("mobile-menu-button");
        const mobileMenu = document.getElementById("mobile-menu");
        const mobileMenuLinks = mobileMenu.querySelectorAll("a");

        // Dark mode toggle variables
        const darkModeToggle = document.getElementById("dark-mode-toggle");
        const darkModeToggleMobile = document.getElementById(
          "dark-mode-toggle-mobile",
        );

        // Function to set mobile menu open/close
        const setMobileMenuOpen = (isOpen) => {
          mobileMenu.setAttribute("aria-hidden", String(!isOpen));
          mobileMenuButton.setAttribute("aria-expanded", String(isOpen));
          mobileMenuButton.setAttribute(
            "aria-label",
            isOpen ? "Close main menu" : "Open main menu",
          );
          mobileMenu.classList.toggle("pointer-events-none", !isOpen);
          mobileMenu.classList.toggle("pointer-events-auto", isOpen);
          mobileMenu.classList.toggle("-translate-y-2", !isOpen);
          mobileMenu.classList.toggle("translate-y-0", isOpen);
          mobileMenu.classList.toggle("opacity-0", !isOpen);
          mobileMenu.classList.toggle("opacity-100", isOpen);
        };

        // Mobile menu event listeners
        mobileMenuButton.addEventListener("click", () => {
          setMobileMenuOpen(
            mobileMenuButton.getAttribute("aria-expanded") !== "true",
          );
        });

        mobileMenuLinks.forEach((link) => {
          link.addEventListener("click", () => setMobileMenuOpen(false));
        });

        document.addEventListener("keydown", (event) => {
          if (
            event.key === "Escape" &&
            mobileMenuButton.getAttribute("aria-expanded") === "true"
          ) {
            setMobileMenuOpen(false);
            mobileMenuButton.focus();
          }
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth >= 768) setMobileMenuOpen(false);
        });

        // Dark mode functionality
        const htmlElement = document.documentElement;
        const THEME_KEY = "theme";

        // Function to set the theme
        const setTheme = (theme) => {
          if (theme === "dark") {
            htmlElement.classList.add("dark");
            // Update icons to show sun (light mode icon) when in dark mode
            if (darkModeToggle) {
              darkModeToggle
                .querySelector(".moon-icon")
                .classList.add("hidden");
              darkModeToggle
                .querySelector(".sun-icon")
                .classList.remove("hidden");
            }
            if (darkModeToggleMobile) {
              darkModeToggleMobile
                .querySelector(".moon-icon")
                .classList.add("hidden");
              darkModeToggleMobile
                .querySelector(".sun-icon")
                .classList.remove("hidden");
            }
          } else {
            htmlElement.classList.remove("dark");
            // Update icons to show moon (dark mode icon) when in light mode
            if (darkModeToggle) {
              darkModeToggle
                .querySelector(".moon-icon")
                .classList.remove("hidden");
              darkModeToggle.querySelector(".sun-icon").classList.add("hidden");
            }
            if (darkModeToggleMobile) {
              darkModeToggleMobile
                .querySelector(".moon-icon")
                .classList.remove("hidden");
              darkModeToggleMobile
                .querySelector(".sun-icon")
                .classList.add("hidden");
            }
          }
          // Save preference to localStorage
          localStorage.setItem(THEME_KEY, theme);
        };

        // Function to toggle between light and dark theme
        const toggleTheme = () => {
          const isDark = htmlElement.classList.contains("dark");
          setTheme(isDark ? "light" : "dark");
        };

        // Determine initial theme
        const getSystemPreference = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";

        const savedTheme = localStorage.getItem(THEME_KEY);
        const initialTheme = savedTheme ? savedTheme : getSystemPreference();
        setTheme(initialTheme);

        // Event listeners for dark mode toggle buttons
        if (darkModeToggle) {
          darkModeToggle.addEventListener("click", toggleTheme);
        }
        if (darkModeToggleMobile) {
          darkModeToggleMobile.addEventListener("click", toggleTheme);
        }
      });
    </script>
  </div>
</header>
