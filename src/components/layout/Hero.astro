---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  badge?: string;
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const {
  title = t('hero.title'),
  subtitle = t('hero.subtitle'),
  ctaText = t('hero.cta'),
  ctaHref = translatePath('/video-to-image-converter'),
  badge = t('hero.badge'),
} = Astro.props;
---

<section class="relative py-20 md:py-32 lg:section overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-gradient" aria-hidden="true"></div>

  <div class="container relative z-10 text-center">
    <span class="eyebrow inline-block mb-6 animate-fade-in">{badge}</span>
    <h1 id="hero-title" class="heading-xl mb-6 animate-slide-up text-balance">
      {title}
    </h1>
    <p class="body-lg mb-10 animate-slide-up" style="animation-delay: 0.1s;">
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 0.2s;">
      <a href={ctaHref} class="btn-primary w-full sm:w-auto" id="hero-cta">
        {ctaText}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
      <a href={translatePath('/#how-it-works')} class="btn-secondary w-full sm:w-auto">
        {t('hero.howItWorks')}
      </a>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-6 text-[var(--color-mute)] body-sm animate-fade-in" style="animation-delay: 0.3s;">
      <span class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="2" ry="2" />
          <path d="M12 8v8M8 12h8" />
        </svg>
        {t('pill.clientSide')}
      </span>
      <span class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        {t('pill.private')}
      </span>
      <span class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
          <circle cx="12" cy="13" r="4" />
        </svg>
        {t('pill.noRegistration')}
      </span>
      <span class="flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="17 8 12 3 7 8" />
          <line x1="12" y1="3" x2="12" y2="15" />
        </svg>
        {t('pill.formats')}
      </span>
    </div>
  </div>
</section>