---
/**
 * @typedef {Object} Props
 * @property {'default'|'elevated'} [variant='default']
 * @property {'none'|'sm'|'md'|'lg'|'xl'} [padding='lg']
 * @property {string} [class]
 * @property {any} [children]
 * @property {string} ['data-testid']
 */

const {
  variant = 'default',
  padding = 'lg',
  class: className = '',
  children,
  'data-testid': testId,
  ...rest
} = Astro.props;

const baseClasses = 'bg-[var(--color-canvas-elevated)] border border-[var(--color-hairline)] rounded-[var(--radius-md)]';

const variantClasses = {
  default: '',
  elevated: 'shadow-[0px_2px_2px_rgba(0,0,0,0.04),0px_8px_16px_-4px_rgba(0,0,0,0.08)]',
};

const paddingClasses = {
  none: '',
  sm: 'p-[var(--spacing-sm)]',
  md: 'p-[var(--spacing-md)]',
  lg: 'p-[var(--spacing-lg)]',
  xl: 'p-[var(--spacing-xl)]',
};

const combinedClasses = `${baseClasses} ${variantClasses[variant]} ${paddingClasses[padding]} ${className}`;
---

<div
  class={combinedClasses}
  data-testid={testId}
  {...rest}
>
  <slot>{children}</slot>
</div>