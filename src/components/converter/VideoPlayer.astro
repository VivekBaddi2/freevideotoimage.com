---
/**
 * @typedef {Object} Props
 * @property {string} src
 * @property {number} [currentTime=0]
 * @property {Function} [onTimeUpdate]
 * @property {Function} [onLoadedMetadata]
 * @property {Function} [onSeeked]
 * @property {string} ['data-testid']
 */

const {
  src,
  currentTime = 0,
  onTimeUpdate,
  onLoadedMetadata,
  onSeeked,
  'data-testid': testId = 'video-player',
  ...rest
} = Astro.props;
---

<div class="relative" data-testid={testId}>
  <video
    id="video-element"
    src={src}
    class="w-[200px] h-[150px] rounded-[var(--radius-md)] bg-[var(--color-canvas)] object-contain"
    controls
    preload="metadata"
    ontimeupdate={(e) => onTimeUpdate?.(e.target.currentTime)}
    onloadedmetadata={onLoadedMetadata}
    onseeked={onSeeked}
    {...rest}
  >
    Your browser does not support the video tag.
  </video>

  <div class="mt-4 space-y-3">
    <div class="flex items-center gap-4">
      <label for="time-input" class="body-sm text-[var(--color-mute)] whitespace-nowrap">
        Time:
      </label>
      <input
        type="number"
        id="time-input"
        step="0.01"
        min="0"
        class="input w-24 text-center"
        value={currentTime.toFixed(2)}
        onchange={(e) => {
          const video = document.getElementById('video-element');
          if (video) video.currentTime = parseFloat(e.target.value);
        }}
      />
      <span class="body-sm text-[var(--color-mute)]" id="duration-display">/ 0:00</span>
    </div>

    <div class="flex items-center gap-3">
      <button
        type="button"
        class="btn-nav"
        onclick={() => {
          const video = document.getElementById('video-element');
          if (video) video.currentTime = Math.max(0, video.currentTime - 1);
        }}
        aria-label="Rewind 1 second"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polygon points="19 20 9 12 19 4 19 20" />
          <line x1="5" y1="19" x2="5" y2="5" />
        </svg>
      </button>

      <button
        type="button"
        class="btn-nav"
        onclick={() => {
          const video = document.getElementById('video-element');
          if (video) video.currentTime = Math.max(0, video.currentTime - 0.033);
        }}
        aria-label="Previous frame (~30fps)"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polygon points="11 19 3 12 11 5 11 19" />
          <line x1="15" y1="5" x2="15" y2="19" />
          <line x1="19" y1="5" x2="19" y2="19" />
        </svg>
      </button>

      <button
        type="button"
        class="btn-primary"
        id="play-pause-btn"
        onclick={() => {
          const video = document.getElementById('video-element');
          if (video) {
            if (video.paused) video.play();
            else video.pause();
          }
        }}
        aria-label="Play/Pause"
      >
        <svg id="play-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polygon points="5 3 19 12 5 21 5 3" />
        </svg>
        <svg id="pause-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="hidden">
          <rect x="6" y="4" width="4" height="16" />
          <rect x="14" y="4" width="4" height="16" />
        </svg>
      </button>

      <button
        type="button"
        class="btn-nav"
        onclick={() => {
          const video = document.getElementById('video-element');
          if (video) video.currentTime = Math.min(video.duration, video.currentTime + 0.033);
        }}
        aria-label="Next frame (~30fps)"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polygon points="13 19 21 12 13 5 13 19" />
          <line x1="5" y1="5" x2="5" y2="19" />
          <line x1="9" y1="5" x2="9" y2="19" />
        </svg>
      </button>

      <button
        type="button"
        class="btn-nav"
        onclick={() => {
          const video = document.getElementById('video-element');
          if (video) video.currentTime = Math.min(video.duration, video.currentTime + 1);
        }}
        aria-label="Forward 1 second"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polygon points="5 4 15 12 5 20 5 4" />
          <line x1="19" y1="5" x2="19" y2="19" />
        </svg>
      </button>
    </div>

    <input
      type="range"
      id="seek-slider"
      min="0"
      max="100"
      value="0"
      step="0.01"
      class="w-full h-2 bg-[var(--color-hairline)] rounded-full appearance-none cursor-pointer accent-[var(--color-ink)]"
      oninput={(e) => {
        const video = document.getElementById('video-element');
        if (video) video.currentTime = (e.target.value / 100) * video.duration;
      }}
      onchange={(e) => {
        const video = document.getElementById('video-element');
        if (video) video.currentTime = (e.target.value / 100) * video.duration;
      }}
      aria-label="Seek video"
    />
  </div>
</div>

<script>
  const video = document.getElementById('video-element');
  const playPauseBtn = document.getElementById('play-pause-btn');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const seekSlider = document.getElementById('seek-slider');
  const durationDisplay = document.getElementById('duration-display');
  const timeInput = document.getElementById('time-input');

  if (video) {
    video.addEventListener('loadedmetadata', () => {
      durationDisplay.textContent = `/ ${formatTime(video.duration)}`;
      timeInput.max = video.duration;
      onLoadedMetadata?.(video.duration);
    });

    video.addEventListener('timeupdate', () => {
      const percent = (video.currentTime / video.duration) * 100;
      seekSlider.value = percent;
      timeInput.value = video.currentTime.toFixed(2);
      onTimeUpdate?.(video.currentTime);
    });

    video.addEventListener('play', () => {
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
    });

    video.addEventListener('pause', () => {
      playIcon.classList.remove('hidden');
      pauseIcon.classList.add('hidden');
    });

    video.addEventListener('seeked', () => {
      onSeeked?.(video.currentTime);
    });

    // Touch scrubbing support
    let touchStartX = 0;
    let touchStartTime = 0;

    seekSlider.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      touchStartTime = video.currentTime;
    }, { passive: true });

    seekSlider.addEventListener('touchmove', (e) => {
      if (!video.duration) return;
      const deltaX = e.touches[0].clientX - touchStartX;
      const percentDelta = (deltaX / seekSlider.offsetWidth) * 100;
      const newPercent = Math.max(0, Math.min(100, parseFloat(seekSlider.value) + percentDelta));
      seekSlider.value = newPercent;
      video.currentTime = (newPercent / 100) * video.duration;
    }, { passive: true });
  }

  function formatTime(seconds) {
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }
</script>