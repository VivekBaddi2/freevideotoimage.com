---
import { getLocaleData } from '../../i18n/locales';
import { useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);
const locale = getLocaleData(lang);

// Extract blog content from locale data (assuming stored under locale.blogPost or similar key)
const post = locale.FromVideoToArtContent;
---

<!-- Blog Post Content -->
<section class="pt-16 md:pt-20 pb-12">
  <div class="container blog-article">
    <div>
      <span class="mono-eyebrow mb-3">{post.eyebrow}</span>
      <h1 class="mb-6 text-xl md:text-2xl lg:text-4xl">{post.title}</h1>
      <p class="body-md max-w-[600px] mb-4">
        {post.subtitle}
      </p>
    </div>

    <!-- Introduction -->
    <div class="prose mx-auto mb-12">
      {post.introduction.map((paragraph: string) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <!-- Getting Started -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.gettingStarted.title}</h2>
      <div class="prose mx-auto">
        <ol class="list-decimal space-y-4 pl-6">
          {post.gettingStarted.steps.map((step: any) => (
            <li>
              <h3 class="heading-md mb-2">{step.heading}</h3>
              <p>{step.content}</p>
              {step.extractionMethods && (
                <ul class="list-disc space-y-2 pl-6 mt-2">
                  {step.extractionMethods.map((method: string) => {
                    const [label, ...desc] = method.split(':');
                    return (
                      <li>
                        <strong>{label}:</strong>{desc.join(':')}
                      </li>
                    );
                  })}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Artistic Techniques -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.artisticTechniques.title}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {post.artisticTechniques.techniques.map((tech: any) => (
          <article class="feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow p-6">
            <h3 class="heading-md mb-3">{tech.heading}</h3>
            <p class="body-md">{tech.description}</p>
            <div class="mt-4 space-y-2">
              <p class="body-sm font-semibold">{tech.techniquesToTryHeading}</p>
              <ul class="list-disc list-inside pl-4 space-y-1 text-[var(--color-mute)]">
                {tech.techniquesToTry.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Best Free Tools for Editing -->
    <section class="mb-12 bg-[var(--color-canvas-elevated)] p-6 rounded-lg">
      <h2 class="heading-lg mb-4">{post.recommendedTools.title}</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {post.recommendedTools.tools.map((tool: any) => (
          <div class="p-4 bg-[var(--color-canvas)] rounded border border-[var(--color-hairline)]">
            <h3 class="heading-md mb-1">{tool.name}</h3>
            <p class="body-sm text-[var(--color-mute)]">{tool.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Conclusion -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.conclusion.title}</h2>
      <div class="prose mx-auto">
        {post.conclusion.paragraphs.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <!-- Back to Blogs -->
    <div class="text-center mb-16">
      <a href={translatePath('/blogs')} class="btn-ghost inline-flex items-center">
        <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        {post.navigation.backLinkText}
      </a>
    </div>
  </div>
</section>