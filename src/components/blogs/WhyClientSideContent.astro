---
import { getLocaleData } from '../../i18n/locales';
import { useTranslatedPath } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const translatePath = useTranslatedPath(lang);
const locale = getLocaleData(lang);

// Extract blog content from locale data
const post = locale.WhyClientSideContent;
---

<!-- Blog Post Content -->
<section class="pt-16 md:pt-20 pb-12">
  <div class="container blog-article">
    <div>
      <span class="mono-eyebrow mb-3">{post.category}</span>
      <h1 class="mb-6 text-xl md:text-2xl lg:text-4xl">
        {post.title}
      </h1>
      <p class="body-md max-w-[600px] mb-4">
        {post.subtitle}
      </p>
    </div>

    <!-- Introduction -->
    <div class="prose mx-auto mb-12">
      {post.introduction.map((paragraph: string) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <!-- What is Client-Side Processing? -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.understandingClientSideProcessing.heading}</h2>
      <div class="prose mx-auto">
        <h3 class="heading-md mb-3">{post.understandingClientSideProcessing.howItWorks.heading}</h3>
        <p>{post.understandingClientSideProcessing.howItWorks.description}</p>
        <ol class="list-decimal space-y-4 pl-6">
          {post.understandingClientSideProcessing.howItWorks.steps.map((step: string) => (
            <li>{step}</li>
          ))}
        </ol>

        <h3 class="heading-md mb-3 mt-6">{post.understandingClientSideProcessing.whatHappensToYourData.heading}</h3>
        <p>{post.understandingClientSideProcessing.whatHappensToYourData.description}</p>
        <ul class="list-disc space-y-2 pl-6">
          {post.understandingClientSideProcessing.whatHappensToYourData.points.map((point: string) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Privacy Risks of Server-Side Processing -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">
        {post.privacyRisksOfServerSideProcessing.heading}
      </h2>
      <div class="prose mx-auto">
        <h3 class="heading-md mb-3">{post.privacyRisksOfServerSideProcessing.subheading}</h3>
        <p>
          {post.privacyRisksOfServerSideProcessing.description}
        </p>
        <div class="grid gap-4 md:grid-cols-2">
          {post.privacyRisksOfServerSideProcessing.risks.map((risk: any) => (
            <div class="feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow p-6">
              <h3 class="heading-md mb-3">{risk.title}</h3>
              <p class="body-md">
                {risk.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Types of Sensitive Content -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">
        {post.whenClientSideProcessingIsImportant.heading}
      </h2>
      <div class="prose mx-auto">
        <p>
          {post.whenClientSideProcessingIsImportant.description}
        </p>
        <div class="grid gap-6 md:grid-cols-3">
          {post.whenClientSideProcessingIsImportant.useCases.map((useCase: any) => (
            <div class="feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow p-6">
              <h3 class="heading-md mb-3">{useCase.title}</h3>
              <p class="body-md">
                {useCase.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Benefits Beyond Privacy -->
    <section class="mb-12 bg-[var(--color-canvas-elevated)] p-6 rounded-lg">
      <h2 class="heading-lg mb-4">
        {post.additionalBenefits.heading}
      </h2>
      <div class="prose mx-auto">
        <div class="grid gap-6 md:grid-cols-2">
          {post.additionalBenefits.benefits.map((benefit: any) => (
            <div class="feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow p-6">
              <h3 class="heading-md mb-3">
                {benefit.title}
              </h3>
              <p class="body-md">
                {benefit.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Best Practices for Sensitive Content -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">
        {post.bestPractices.heading}
      </h2>
      <div class="prose mx-auto">
        <ol class="list-decimal space-y-4 pl-6">
          {post.bestPractices.practices.map((practice: any) => (
            <li>
              <h3 class="heading-md mb-2">{practice.title}</h3>
              <p>
                {practice.description}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Conclusion -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.conclusion.heading}</h2>
      <div class="prose mx-auto">
        {post.conclusion.content.map((paragraph: string) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>

    <!-- Back to Blogs -->
    <div class="text-center mb-16">
      <a href={translatePath('/blogs')} class="btn-ghost inline-flex items-center">
        <svg
          class="ml-2 w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 12H5M12 5l-7 7 7 7"></path>
        </svg>
        {post.navigation.backToBlogs}
      </a>
    </div>
  </div>
</section>