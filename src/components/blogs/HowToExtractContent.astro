---
import { getLocaleData } from "../../i18n/locales";
import { useTranslatedPath } from "../../i18n/utils";
import type { SupportedLanguage } from "../../i18n/ui";

interface Props {
  lang?: SupportedLanguage;
}

const { lang = "en" } = Astro.props;
const translatePath = useTranslatedPath(lang);
const locale = getLocaleData(lang);

// Load the dynamic blog post data from your locale object
const post = locale.HowToExtractContent;
---

<section class="pt-16 md:pt-20 pb-12">
  <div class="container blog-article">
    <div>
      <span class="mono-eyebrow mb-3">{post.eyebrow}</span>
      <h1 class="mb-6 text-xl md:text-2xl lg:text-4xl">{post.title}</h1>
      <p class="body-md max-w-[600px] mb-4">
        {post.subtitle}
      </p>
    </div>

    <!-- Introduction -->
    <div class="prose mx-auto mb-12">
      {post.introduction.map((paragraph: string) => <p>{paragraph}</p>)}
    </div>

    <!-- Preparation -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.preparation.sectionTitle}</h2>
      <div class="prose mx-auto">
        <ol class="list-decimal space-y-4 pl-6">
          {
            post.preparation.steps.map((step: any) => (
              <li>
                <h3 class="heading-md mb-2">{step.heading}</h3>
                <p>{step.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Extraction Methods -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.extractionMethods.sectionTitle}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          post.extractionMethods.methods.map((method: any, index: number) => (
            <article
              class={`feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow p-6 ${index === 2 ? "md:col-span-2" : ""}`}
            >
              <h3 class="heading-md mb-3">{method.name}</h3>
              <p class="body-md">{method.description}</p>
              <div class="mt-4 space-y-2">
                <p class="body-sm font-semibold">{method.bestForLabel}</p>
                <ul class="list-disc list-inside pl-4 space-y-1 text-[var(--color-mute)]">
                  {method.bestForList.map((item: string) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Tips for Best Results -->
    <section class="mb-12 bg-[var(--color-canvas-elevated)] p-6 rounded-lg">
      <h2 class="heading-lg mb-4">
        {post.tipsForBestResults.sectionTitle}
      </h2>
      <div class="prose mx-auto">
        <ul class="list-disc space-y-4 pl-6">
          {
            post.tipsForBestResults.tips.map((tip: any) => (
              <li>
                <h3 class="heading-md mb-2">{tip.heading}</h3>
                <p>{tip.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Common Use Cases -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.commonUseCases.sectionTitle}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          post.commonUseCases.cases.map((useCase: any) => (
            <div class="feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow p-6">
              <h3 class="heading-md mb-3">{useCase.title}</h3>
              <p class="body-md">{useCase.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Conclusion -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.conclusion.sectionTitle}</h2>
      <div class="prose mx-auto">
        {
          post.conclusion.paragraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))
        }
      </div>
    </section>

    <!-- Back to Blogs -->
    <div class="text-center mb-16">
      <a
        href={translatePath("/blogs")}
        class="btn-ghost inline-flex items-center"
      >
        <svg
          class="ml-2 w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 12H5M12 5l-7 7 7 7"></path>
        </svg>
        {post.navigation.backButtonText}
      </a>
    </div>
  </div>
</section>
