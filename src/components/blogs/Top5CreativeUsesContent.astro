---
import { getLocaleData } from "../../i18n/locales";
import { useTranslatedPath } from "../../i18n/utils";
import type { SupportedLanguage } from "../../i18n/ui";

interface Props {
  lang?: SupportedLanguage;
}

const { lang = "en" } = Astro.props;
const translatePath = useTranslatedPath(lang);
const locale = getLocaleData(lang);

// Extract blog content from locale data
const post = locale.Top5CreativeUsesContent;
---

<!-- Blog Post Content -->
<section class="pt-16 md:pt-20 pb-12">
  <div class="container blog-article">
    <div>
      <span class="mono-eyebrow mb-3">{post.eyebrow}</span>
      <h1 class="mb-6 text-xl md:text-2xl lg:text-4xl">
        {post.title}
      </h1>
      <p class="body-md max-w-[600px] mb-4">
        {post.subtitle}
      </p>
    </div>

    <!-- Introduction -->
    <div class="prose mx-auto mb-12">
      {post.introduction.map((paragraph: string) => <p>{paragraph}</p>)}
    </div>

    <!-- Creative Applications -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.creativeApplicationsSection.title}</h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          post.creativeApplicationsSection.applications.map(
            (app: any, index: number) => (
              <article
                class={`feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow p-6 ${
                  index === 4 ? "md:col-span-2 lg:col-span-2" : ""
                }`}
              >
                <span class="blog-card-meta mb-3 inline-block">
                  {app.category}
                </span>
                <h3 class="heading-md mb-3">{app.title}</h3>
                <p class="body-md mb-4">{app.description}</p>
                <div class="space-y-2">
                  <p class="body-sm font-semibold">{app.howToUseTitle}</p>
                  <ul class="list-disc list-inside pl-4 space-y-1 text-[var(--color-mute)]">
                    {app.howToUseList.map((item: string) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ),
          )
        }
      </div>
    </section>

    <!-- Best Practices for Designers -->
    <section class="mb-12 bg-[var(--color-canvas-elevated)] p-6 rounded-lg">
      <h2 class="heading-lg mb-4">{post.bestPracticesSection.title}</h2>
      <div class="prose mx-auto">
        <ul class="list-disc space-y-4 pl-6">
          {
            post.bestPracticesSection.practices.map((practice: any) => (
              <li>
                <h3 class="heading-md mb-2">{practice.title}</h3>
                <p>{practice.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Conclusion -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.conclusionSection.title}</h2>
      <div class="prose mx-auto">
        {
          post.conclusionSection.paragraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))
        }
      </div>
    </section>

    <!-- Back to Blogs -->
    <div class="text-center mb-16">
      <a
        href={translatePath("/blogs")}
        class="btn-ghost inline-flex items-center"
      >
        <svg
          class="ml-2 w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 12H5M12 5l-7 7 7 7"></path>
        </svg>
        {post.navigation.backButtonText}
      </a>
    </div>
  </div>
</section>
