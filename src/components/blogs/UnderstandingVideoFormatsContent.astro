---
import { getLocaleData } from "../../i18n/locales";
import { useTranslatedPath } from "../../i18n/utils";
import type { SupportedLanguage } from "../../i18n/ui";

interface Props {
  lang?: SupportedLanguage;
}

const { lang = "en" } = Astro.props;
const translatePath = useTranslatedPath(lang);
const locale = getLocaleData(lang);

// Extract blog content from locale data
const post = locale.UnderstandingVideoFormatsContent;

const formatColors: Record<string, string> = {
  PNG: "text-[var(--color-cyan)]",
  JPG: "text-[var(--color-violet)]",
  WebP: "text-[var(--color-pink)]",
  AVIF: "text-[var(--color-magenta)]",
};
---

<!-- Blog Post Content -->
<section class="pt-16 md:pt-20 pb-12">
  <div class="container blog-article">
    <div class="">
      <span class="mono-eyebrow mb-3">{post.eyebrow}</span>
      <h1 class="mb-6 text-xl md:text-2xl lg:text-4xl">{post.title}</h1>
      <p class="body-md max-w-[600px] mb-4">
        {post.subtitle}
      </p>
    </div>

    <!-- Introduction -->
    <div class="prose mx-auto mb-12">
      {post.introduction.map((paragraph: string) => <p>{paragraph}</p>)}
    </div>

    <!-- Format Comparison -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.formatComparisonOverview.title}</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-[var(--color-hairline)]">
          <thead class="bg-[var(--color-canvas-elevated)]">
            <tr>
              <th
                class="px-6 py-4 text-left text-xs font-medium text-[var(--color-mute)] uppercase tracking-wider"
                >Format</th
              >
              <th
                class="px-6 py-4 text-left text-xs font-medium text-[var(--color-mute)] uppercase tracking-wider"
                >Compression Type</th
              >
              <th
                class="px-6 py-4 text-left text-xs font-medium text-[var(--color-mute)] uppercase tracking-wider"
                >Quality Range</th
              >
              <th
                class="px-6 py-4 text-left text-xs font-medium text-[var(--color-mute)] uppercase tracking-wider"
                >Transparency</th
              >
              <th
                class="px-6 py-4 text-left text-xs font-medium text-[var(--color-mute)] uppercase tracking-wider"
                >Best Use Cases</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-hairline)]">
            {
              post.formatComparisonOverview.table.map((row: any) => (
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-[var(--color-ink)]">
                    {row.format}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-[var(--color-mute)]">
                    {row.compressionType}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-[var(--color-mute)]">
                    {row.qualityRange}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-[var(--color-mute)]">
                    {row.transparency}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-[var(--color-mute)]">
                    {row.bestUseCases}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- Detailed Format Explanations -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.detailedFormatExplanations.title}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          post.detailedFormatExplanations.formats.map((fmt: any) => (
            <article
              class={`feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow p-6 ${fmt.name === "WebP" ? "md:col-span-2" : ""}`}
            >
              <h3 class="heading-md mb-3 flex items-start gap-3">
                <span
                  class={`flex-shrink-0 ${formatColors[fmt.name] || ""} text-2xl mt-0.5`}
                >
                  {fmt.name}
                </span>
                <div>
                  <p class="body-md mb-2">{fmt.fullName}</p>
                  <p class="body-sm text-[var(--color-mute)]">{fmt.subtitle}</p>
                </div>
              </h3>
              <div class="prose mx-auto">
                <p>
                  <strong>How it works:</strong> {fmt.howItWorks}
                </p>
                <p>
                  <strong>When to use it:</strong>
                </p>
                <ul class="list-disc space-y-2 pl-6 mt-4">
                  {fmt.whenToUseIt.map((item: string) => (
                    <li>{item}</li>
                  ))}
                </ul>
                {fmt.browserSupport && (
                  <p>
                    <strong>Browser support:</strong> {fmt.browserSupport}
                  </p>
                )}
                <p>
                  <strong>Limitations:</strong> {fmt.limitations}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Practical Recommendations -->
    <section class="mb-12 bg-[var(--color-canvas-elevated)] p-6 rounded-lg">
      <h2 class="heading-lg mb-4">{post.practicalRecommendations.title}</h2>
      <div class="prose mx-auto">
        <div class="grid gap-6 md:grid-cols-2">
          {
            post.practicalRecommendations.recommendations.map((item: any) => (
              <div class="feature-card hover:shadow-[0px_2px_8px_rgba(0,0,0,0.04)] transition-shadow p-6">
                <h3 class="heading-md mb-3">{item.useCase}</h3>
                <p class="body-md">{item.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Quality vs File Size Visual Guide -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.qualityVsFileSize.title}</h2>
      <div class="prose mx-auto">
        <p>{post.qualityVsFileSize.introText}</p>
        <ol class="list-decimal space-y-4 pl-6">
          {
            post.qualityVsFileSize.considerations.map((item: any) => (
              <li>
                <h3 class="heading-md mb-2">{item.title}</h3>
                <p>{item.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Conclusion -->
    <section class="mb-12">
      <h2 class="heading-lg mb-4">{post.conclusion.title}</h2>
      <div class="prose mx-auto">
        {
          post.conclusion.paragraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))
        }
      </div>
    </section>

    <!-- Back to Blogs -->
    <div class="text-center mb-16">
      <a
        href={translatePath("/blogs")}
        class="btn-ghost inline-flex items-center"
      >
        <svg
          class="ml-2 w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 12H5M12 5l-7 7 7 7"></path>
        </svg>
        {post.navigation.backToBlogsText}
      </a>
    </div>
  </div>
</section>
